# Xcode / SwiftPM build output
build/
DerivedData/
.build/
**/.build/
xcuserdata/
*.xcuserdatad/
*.xcuserstate
.swiftpm/
**/.swiftpm/

# Python tooling caches (the sanitize guard and the gates are Python)
__pycache__/
*.py[cod]

# Private overlay — real values live here and never get published; the
# committed content.example.json documents its shape. The non-AI lane folder
# names are library content, so the real file is bundled into the app at
# build time and never committed. The sanitize blocklist is not listed here
# at all: it sits beside the checkouts, in no repository, which is a stronger
# promise than a .gitignore line.
/WarmGun/content.local.json

# pCloud conflict copies (the Haglio trees sync via pCloud). Never our files; an
# untracked one dirties main and blocks merges. '[' escaped to match literally.
*\[conflicted*

.DS_Store
